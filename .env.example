# =============================================================================
# FICOS Maritime Intelligence Platform — Environment Configuration (.env)
# =============================================================================

# Server Networking
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
MODEL_VERSION=3.0.0

# Allowed CORS Origins (comma-separated or wildcard for initial setup)
# Example: https://ficos-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,*

# Base Directories (Leave blank to use defaults relative to project root)
# FICOS_CONFIGS_DIR=./configs
# FICOS_DATA_DIR=./data
# FICOS_OUTPUTS_DIR=./outputs
# FICOS_MODELS_DIR=./models

# Custom Dataset & Artifact Paths (Optional overrides)
# FICOS_DATASET_A_PATH=./data/dataset_a_final_clean.csv
# FICOS_DATASET_B_PATH=./data/dataset_b_mvp.xlsx
# FICOS_DATASET_C_PATH=./data/dataset_c_disruptions.csv
# FICOS_MODELING_DATASET_PATH=./outputs/modeling_dataset.csv
